# Copy to server/.env and fill in. Never commit .env — it is gitignored, and
# `bash bin/os selftest` will fail if a credential ever lands in a tracked file.
#
# Everything here is a *boot-time* default. Anything you might want to change while
# looking at the result — model, provider, temperature, retrieval weights — is also
# editable live in the UI under Settings, which writes server/settings.local.json
# and takes precedence over this file. No restart.

# ---------------------------------------------------------------------- auth
# One user, one password. No registration, no reset, no second account.
#
# Generate both lines with:
#     python -m server.passwd
#
# It prints AGENTOS_USER, AGENTOS_PASSWORD_HASH and a SESSION_SECRET. Paste them
# here. An empty credential config denies everyone, including you — that is the
# safe default, not a bug.
AGENTOS_USER=
AGENTOS_PASSWORD_HASH=

# Plaintext alternative. Works, but it is a password sitting in a file, and the UI
# will nag about it until you replace it with the hash above.
# AGENTOS_PASSWORD=

# openssl rand -hex 32   (or take the one `python -m server.passwd` prints)
# Without this, everyone is signed out on every restart.
SESSION_SECRET=
SESSION_DAYS=30

# Brute-force ceiling, counted per client address in memory.
LOGIN_MAX_FAILS=8
LOGIN_LOCKOUT_SECONDS=900

# Only turn this on if something in front of the app actually sets
# X-Forwarded-For. Trusting it otherwise lets any client forge a fresh address per
# request and walk straight through the lockout.
AGENTOS_TRUST_PROXY=false

# ----------------------------------------------------------------- inference
# Any OpenAI-compatible endpoint.
#   OpenRouter : https://openrouter.ai/api/v1        key from openrouter.ai/keys
#   OrcaRouter : https://api.orcarouter.ai/v1        key from orcarouter.ai/console
#   OpenAI     : https://api.openai.com/v1
#   Together   : https://api.together.xyz/v1
#   Ollama     : http://127.0.0.1:11434/v1           key can be any non-empty string
#
# Prefer setting the key in the UI: it lands in settings.local.json with mode 600
# and is never echoed back to the browser. This variable is here for unattended
# deploys.
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Tried in order when the primary is rate-limited or down. Free-tier models do this
# routinely, so a fallback is worth setting.
#
# Read the quota model before trusting this to save you: OpenRouter's free tier is
# 50 requests/day and 20/minute counted ACROSS THE WHOLE ACCOUNT, not per model.
# A chain of four :free models therefore rides out a per-minute spike and does
# nothing at all about the daily cap — when the day's 50 are gone, every entry in
# the chain returns 429 together. The fixes that actually work are a one-time $10
# credit purchase (which lifts the cap to 1000/day) or a second provider on a
# separate quota, e.g. ORCAROUTER_API_KEY below.
# LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free, minimax/minimax-m2.7:free, poolside/laguna-s-2.1:free

# Second provider, on a quota independent of OpenRouter's. Only read when
# LLM_BASE_URL points at OrcaRouter — this app has a single provider seam, so the
# key here is for switching to, not for automatic cross-provider failover. The
# harness (deploy/harness/) CAN hold both routes at once and does.
#
# Reachable models depend on your OrcaRouter balance: deepseek/deepseek-v4-flash-free
# serves on a zero balance, while orcarouter/auto and the fusion-* ensembles are
# credit-gated and answer 402 until you top up.
ORCAROUTER_API_KEY=

# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=0          # 0 leaves it to the provider
# LLM_TIMEOUT=90
# LLM_REASONING_EFFORT=off  # off | low | medium | high (reasoning models only)

# ------------------------------------------------------------------ gauntlet
# Builder and critic should be DIFFERENT models. A model grading its own output
# grades generously, which is the main way a gauntlet loop stops working.
# Blank means "use LLM_MODEL".
# GAUNTLET_BUILDER_MODEL=
# GAUNTLET_CRITIC_MODEL=
# GAUNTLET_MAX_ROUNDS=4

# -------------------------------------------------------------------- server
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=8000

# Public origin, no trailing slash. Setting this to an https URL also turns on
# Secure cookies and HSTS.
AGENTOS_BASE_URL=https://your-machine.your-tailnet.ts.net

# AGENTOS_VAULT=/home/ec2-user/Agentic-OS/brain
# AGENTOS_DB=/home/ec2-user/Agentic-OS/server/index.db
# AGENTOS_SETTINGS=/home/ec2-user/Agentic-OS/server/settings.local.json

# Set this and every note gets an "open on GitHub" link.
# REPO_URL=https://github.com/you/your-brain

# ---------------------------------------------------------------- embeddings
EMBED_ENABLED=true
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# Asymmetric embedding prefixes. The BGE family wants the instruction on queries
# only; E5 models want 'query: ' and 'passage: ' instead.
# EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
# EMBED_PASSAGE_PREFIX=

# ----------------------------------------------------------------- retrieval
CHUNK_CHARS=1100
CHUNK_OVERLAP=150
TOP_K=8

# Hybrid fusion. Measure before changing:
#     python -m server.tools.eval_retrieval
#     python -m server.tools.eval_retrieval --sweep
RRF_K=20
W_KEYWORD=1.0
W_SEMANTIC=2.0
POOL_MULT=6

# Name-match nudge. Neither BM25 nor the vectors can see a note's title, so typing
# a note's name was the search this was worst at. On the bundled benchmark, 0
# scores top-1 7/16 and 0.08 scores 12/16.
W_TITLE=0.08

# ------------------------------------------------------- MCP / the harness
# The vault-as-tools endpoint at /mcp, used by the JM Agentic-OS Harness
# (deploy/harness/). This is the only surface on this app that can WRITE to the
# vault, so it is opt-in by the strongest available mechanism: with no token
# below, the route is never registered at all — not disabled, absent.
#
# Generate one with:  openssl rand -hex 32
# deploy/install-harness.sh does this for you. Minimum 24 characters.
#
# Whatever holds this token can create, edit and delete notes in brain/. It
# cannot escape brain/, edit AGENTS.md, config/, server/ or bin/, rewrite the
# journal, or act without leaving a git commit — see server/mcp.py for the
# threat model and server/authoring.py for the enforcement.
AGENTOS_MCP_TOKEN=

# Off by default: only connections from this machine are accepted, which is all
# the harness needs because it runs beside the app. Turning this on exposes vault
# write access to anything on the network that has the token above. Don't.
AGENTOS_MCP_ALLOW_REMOTE=false

# ------------------------------------------------------------------ dev only
# Skips authentication entirely. Ignored unless AGENTOS_HOST is loopback, so it
# cannot accidentally ship an open instance.
DEV_NO_AUTH=false
