[Unit]
Description=AgentOS visual second brain
Documentation=https://github.com/jmbilbao25/Agentic-OS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/server/.env

# Bound to loopback on purpose. Tailscale Funnel terminates TLS and forwards
# here, so the app is never directly exposed. Changing this to 0.0.0.0 would
# publish a surface that has no password on it yet to a public IP.
ExecStart=__DIR__/.venv/bin/uvicorn server.app:app \
  --host 127.0.0.1 --port 8000 \
  --proxy-headers --forwarded-allow-ips=127.0.0.1 \
  --log-level info

Restart=always
RestartSec=3

# 1 GB box: cap the app so a runaway reindex cannot take the whole machine down
# with it. Hitting this restarts the unit instead of triggering a global OOM.
MemoryMax=700M
MemoryHigh=560M

# hardening — the app only ever needs to read the repo and write its index
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The whole repo, not just server/. This was `__DIR__/server` while the app was
# strictly read-only over the vault, and that stopped being true when it grew
# endpoints that write: /api/run/radar writes brain/raw/ and brain/output/, and
# /api/sync runs `git pull`, which writes .git/. Both failed with
# "OSError: [Errno 30] Read-only file system" while the service itself looked
# perfectly healthy — the scheduled timer kept working because it runs as its own
# unit without this hardening, so only the UI buttons were broken.
# Everything outside the repo stays read-only.
ReadWritePaths=__DIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
