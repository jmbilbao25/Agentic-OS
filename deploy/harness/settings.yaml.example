# DSH user settings for the JM Agentic-OS Harness.
#
# Install to $DSH_HOME/settings.yaml. DSH's own default for DSH_HOME is ~/.dsh,
# but deploy/systemd/jm-harness.service overrides it to ~/.dsh-harness so the
# harness's state cannot collide with an interactive `dsh` run by the same user —
# so on a deployed box the live file is ~/.dsh-harness/settings.yaml. Check
# `systemctl show jm-harness -p Environment` before going looking for it.
#
# Hot-reloaded: editing it takes effect on the next request, with no restart.
#
# Why this file exists separately from the cordis patch: which LLM *adapters* are
# mounted is composition (the patch), but which *providers* actually run is user
# settings. The pi-ai adapter mounts dormant with zero routes and registers them
# the moment this section supplies profiles. This is also exactly what the web
# Models page writes, so anything set here can be changed from the UI later.

llm-pi-ai:
  providers:
    # The route key IS the provider name referenced by `agent-default-model` in
    # jm-agentic-os.cordis.yml. Renaming it here means renaming it there.
    openrouter:
      displayName: OpenRouter
      # OpenRouter is not in pi-ai's installed catalog, so this route has to
      # declare its own protocol, endpoint and model list — a route the catalog
      # does not ship is refused outright without all three.
      api: openai-completions
      baseURL: https://openrouter.ai/api/v1
      # A reference to an environment variable, resolved per request through the
      # credential seam. The key itself never enters this file.
      apiKeyEnv: OPENROUTER_API_KEY

      models:
        # The default, because it is the cheapest one that reliably answers.
        # $0.075/M prompt, and it reasons and calls tools. 1.3M context.
        - id: z-ai/glm-5.3-flash
          name: GLM 5.3 Flash
          contextWindow: 1310720
          # 8192, and the number matters for billing, not just for taste.
          #
          # Configuring maxTokens makes it this model's per-request default, and
          # OpenRouter reserves `input_cost + maxTokens x output_price` BEFORE
          # running the request. At 32768 that reservation exceeded a small
          # balance and every turn failed with
          #   402 — "requires more credits, or fewer max_tokens. You requested up
          #          to 32768 tokens, but can only afford 14617"
          # while the turn itself would have cost a third of that. A ceiling you
          # never reach is still a ceiling you pay to reserve.
          maxTokens: 8192
          input: [ text, image ]

        # Free, 256k context, supports tool calling — and rate-limited upstream
        # often enough to fail the first message of a session. Kept because when
        # it works it costs nothing; not the default because a harness whose
        # opening turn 429s looks broken rather than busy.
        - id: z-ai/glm-5.2:free
          name: GLM 5.2 (free — rate-limits)
          contextWindow: 256000
          maxTokens: 8192

        # Full GLM 5.2 for work that warrants it. ~16x the price of Flash.
        - id: z-ai/glm-5.2
          name: GLM 5.2
          contextWindow: 1048576
          maxTokens: 8192

        # Verified live 2026-08-30 against this deployment's key: volunteers tool
        # calls unprompted (not just when tool_choice forces one), which is what
        # the PLAN/RESEARCH/EXECUTE loop actually needs. $0.065/M prompt — 13%
        # under Flash. Text-only input, so Flash stays the default for anything
        # involving a screenshot or an image.
        - id: deepseek/deepseek-v4-flash-0731
          name: DeepSeek V4 Flash
          contextWindow: 1310720
          maxTokens: 8192

        # Escalation only, never the default: ~19x Flash's input price. For
        # architecture, gnarly refactors, and long reasoning chains where Flash
        # visibly fumbles. Verified tool-calling. Text-only input.
        - id: z-ai/glm-5.3
          name: GLM 5.3 (escalation — 19x Flash)
          contextWindow: 1310720
          maxTokens: 8192

        # ── free routes, verified live 2026-08-30 ───────────────────────────────
        # Every entry below was tested twice against this deployment's key: once
        # unforced (does it VOLUNTEER a tool call?) and once fed a completed tool
        # result (does it synthesise, or re-call and loop?). Catalog metadata was
        # not trusted — several models advertising `tools` failed one or both.
        #
        # HARD LIMIT: all :free models share one quota of 50 requests/day on this
        # account (20/min), rising to 1000/day only after a one-time $10 credit
        # purchase. One agent task burns 5-15 requests. Treat these as a fallback
        # for when credits run dry, not as the daily driver.
        #
        # Because that quota is account-wide rather than per-model, listing more
        # free routes here buys resilience against a single model being throttled
        # and none whatsoever against the daily ceiling. The orcarouter route
        # below exists for that: a different vendor is a different bucket.
        #
        # Rejected, with reasons — do not re-add without retesting:
        #   dots-studio/dots-3-note-preview:free  200 but EMPTY content
        #   google/gemma-4-31b-it:free            429 (also -26b-a4b)
        #   z-ai/glm-5.2:free                     429 on 3/3 tries
        #   thinkingmachines/inkling{,-small}:free 403, gated to registered apps
        #   minimax/minimax-m3:free               will not volunteer a tool call
        #   cohere/north-mini-code:free           will not volunteer a tool call
        #   liquid/lfm-2.5-2.6b:free              2.6B / 65K, too weak to trust

        # Best free pick. Volunteered a tool call unprompted AND synthesised the tool
        # result cleanly. Largest context of any working free model.
        - id: nvidia/nemotron-3.5-lightning:free
          name: Nemotron 3.5 Lightning (free)
          contextWindow: 1000000
          maxTokens: 8192

        # Strongest free model here (550B MoE). Round-trips tool results well, but did
        # not volunteer a call on the first probe — slightly less eager than Lightning,
        # so prefer it for reasoning over autonomous tool use.
        - id: nvidia/nemotron-3-ultra-550b-a55b:free
          name: Nemotron 3 Ultra 550B (free)
          contextWindow: 1000000
          maxTokens: 8192

        # Volunteers tool calls; a reasoning model, so it spends output budget thinking.
        # Raise maxTokens if answers arrive truncated.
        - id: nvidia/nemotron-3-super-120b-a12b:free
          name: Nemotron 3 Super 120B (free)
          contextWindow: 262144
          maxTokens: 8192

        # Non-NVIDIA fallback so a single vendor outage does not take out every free
        # route. Volunteers calls, clean round-trip.
        - id: minimax/minimax-m2.7:free
          name: MiniMax M2.7 (free)
          contextWindow: 196608
          maxTokens: 8192

        # Code-oriented. Volunteers calls, clean round-trip. Good for the application
        # and automation work; weaker as a general daily driver.
        - id: poolside/laguna-s-2.1:free
          name: Laguna S 2.1 (free — code)
          contextWindow: 262144
          maxTokens: 8192

      # Attribution headers. OpenRouter uses these for its rankings page and, more
      # usefully, they make this deployment identifiable in your own usage log.
      headers:
        HTTP-Referer: https://github.com/jmbilbao25/Agentic-OS
        X-Title: JM Agentic-OS Harness

    # ── OrcaRouter — a second vendor, so a second free quota ────────────────
    #
    # Exists for exactly one reason: OpenRouter's free ceiling is account-wide, so
    # no amount of model-juggling inside that route survives the day's 50th
    # request. OrcaRouter is a different account with a different bucket, which is
    # the only kind of fallback that helps once the daily cap is the thing that
    # broke. OpenAI-compatible, so it needs no adapter work — same three settings.
    #
    # Verified 2026-08-30 against this deployment's key. What the balance endpoint
    # says matters more than the catalog here: GET /v1/balance reported
    # paid_balance 0, and on a zero balance most of this vendor's catalog is
    # credit-gated. Tested, with results:
    #
    #   deepseek/deepseek-v4-flash-free   200 x3, volunteers a tool call unprompted,
    #                                     synthesises the tool result cleanly. KEPT.
    #   orcarouter/free                   200, then 402 free_quota_exhausted, then
    #                                     200 again — a rolling window with no
    #                                     published size and no ratelimit headers
    #                                     to plan against. KEPT, but second.
    #   orcarouter/auto                   402, needs $0.0005. Credit-gated.
    #   orcarouter/fusion-flash           500 "parallel ensemble produced no
    #                                     servable response" on a zero balance.
    #   orcarouter/fusion, fusion-mini    same ensemble family, same gate.
    #   orca/dub                          402. Also: it is a video dubbing model,
    #                                     video->video at $0.60/minute. The $6 of
    #                                     "free credit" on this account is locked
    #                                     to it and is not spendable here.
    #
    # Do not add the credit-gated ids back on the strength of the catalog listing
    # them — a route that 402s is worse than an absent one, because the harness
    # will offer it in the model picker and fail at the first turn.
    orcarouter:
      displayName: OrcaRouter
      api: openai-completions
      baseURL: https://api.orcarouter.ai/v1
      # Same credential seam as every other route: a name, never the key.
      apiKeyEnv: ORCAROUTER_API_KEY

      models:
        # The one route that serves on a zero balance. A reasoning model: it
        # returns `reasoning_content` alongside `content`, and reasoning tokens
        # are drawn from the SAME output budget — a 16-token cap produced an empty
        # content field and finish_reason "length", which looks like a broken
        # model rather than an exhausted budget. 8192 leaves ample room; do not
        # tighten it below ~1024.
        - id: deepseek/deepseek-v4-flash-free
          name: DeepSeek V4 Flash (OrcaRouter — free)
          contextWindow: 1048576
          maxTokens: 8192

        # OrcaRouter's own free router. Resolves to the model above today
        # (x-orca-resolved-model says so), but it is a routing decision they can
        # change, and it intermittently 402s. Listed after the explicit id so the
        # picker's first OrcaRouter entry is the predictable one.
        - id: orcarouter/free
          name: OrcaRouter Free (auto-routed — intermittent 402)
          contextWindow: 200000
          maxTokens: 8192

    # ── Gemini, via the local thought_signature shim ────────────────────────
    #
    # baseURL points at 127.0.0.1, not at Google. Gemini 3.x requires the
    # thought_signature it returns with each tool call to be echoed back, and it
    # travels in a non-standard `tool_calls[].extra_content.google` field that
    # pi-ai's openai-completions path drops — so a second turn after any tool
    # call answers 400. Verified 2026-08-30: direct + stripped = 400, through the
    # shim = 200, at every reasoning level including omitted and "none".
    # deploy/harness/gemini-shim/ holds the proxy, its unit, and the evidence.
    #
    # pi-ai does not recognise a localhost endpoint, so it applies its OpenAI
    # defaults: system prompt as the `developer` role, output cap as
    # `max_completion_tokens`, thinking level as a bare `reasoning_effort`.
    # All three were tested against Google's compat surface and accepted, which
    # is why this route needs no `compat` overrides.
    gemini:
      displayName: Gemini (via local shim)
      api: openai-completions
      baseURL: http://127.0.0.1:8787/v1
      # Resolved per request through the credential seam; the key lives only in
      # deploy/harness/harness.env (gitignored) and never enters this file.
      apiKeyEnv: GEMINI_API_KEY

      models:
        - id: gemini-3.7-flash
          name: Gemini 3.7 Flash
          contextWindow: 1048576
          # 8192 to match the house convention. Gemini will serve up to 65536.
          maxTokens: 8192
          # `off` is deliberately absent: as a bare YAML key it parses as boolean
          # false under YAML 1.1. Add it as `"off": none` (quoted) if wanted —
          # Google does accept reasoning_effort "none".
          reasoningEfforts:
            low: low
            medium: medium
            high: high

agent-default-model:
  provider: openrouter
  model: nvidia/nemotron-3-ultra-550b-a55b:free
