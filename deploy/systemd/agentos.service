[Unit]
Description=AgentOS visual second brain
Documentation=https://github.com/jmbilbao25/Agentic-OS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/server/.env

# Bound to loopback on purpose. Tailscale Funnel terminates TLS and forwards
# here, so the app is never directly exposed. Changing this to 0.0.0.0 would
# publish an unauthenticated-until-OAuth surface on a public IP.
ExecStart=__DIR__/.venv/bin/uvicorn server.app:app \
  --host 127.0.0.1 --port 8000 \
  --proxy-headers --forwarded-allow-ips=127.0.0.1 \
  --log-level info

Restart=always
RestartSec=3

# 1 GB box: cap the app so a runaway reindex cannot take the whole machine down
# with it. Hitting this restarts the unit instead of triggering a global OOM.
MemoryMax=700M
MemoryHigh=560M

# hardening — the app only ever needs to read the repo and write its index
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DIR__/server
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
