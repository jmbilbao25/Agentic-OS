# Copy to server/.env and fill in. Never commit .env.

# ---------------------------------------------------------------- inference
# Any OpenAI-compatible endpoint. Default is OpenRouter's free tier.
#   OpenRouter : https://openrouter.ai/api/v1        key from openrouter.ai/keys
#   OpenAI     : https://api.openai.com/v1
#   Hermes     : http://127.0.0.1:8765/v1            (hermes api-server)
#   Ollama     : http://127.0.0.1:11434/v1           key can be any non-empty string
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------------------------------------------------------------- auth
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
#   Application type: Web application
#   Authorised redirect URI must exactly equal OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. An EMPTY list denies everyone — that is intentional.
ALLOWED_EMAILS=bilbaojohnmichael@gmail.com

# Public origin, no trailing slash. With Tailscale Funnel this is your ts.net name.
AGENTOS_BASE_URL=https://your-machine.your-tailnet.ts.net
OAUTH_REDIRECT_URI=https://your-machine.your-tailnet.ts.net/auth/callback

# openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=30

# ---------------------------------------------------------------- server
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=8000
# AGENTOS_VAULT=/home/ec2-user/Agentic-OS/brain
# AGENTOS_DB=/home/ec2-user/Agentic-OS/server/index.db

# ---------------------------------------------------------------- embeddings
EMBED_ENABLED=true
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# ---------------------------------------------------------------- retrieval
CHUNK_CHARS=1100
CHUNK_OVERLAP=150
TOP_K=8

# Hybrid fusion. Tune with: python -m server.tools.eval_retrieval --sweep
RRF_K=20
W_KEYWORD=1.0
W_SEMANTIC=2.0
POOL_MULT=6

# Asymmetric embedding prefixes. The BGE family wants the instruction on
# queries only; E5 models want 'query: ' and 'passage: ' instead.
# EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
# EMBED_PASSAGE_PREFIX=

# Local development only. Ignored unless AGENTOS_HOST is loopback.
DEV_NO_AUTH=false
