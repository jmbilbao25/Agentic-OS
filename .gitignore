.obsidian/workspace.json
.obsidian/workspace-mobile.json
.DS_Store
__pycache__/
*.pyc

# server runtime
server/.env
server/settings.local.json     # holds the API key set from the UI
server/index.db
server/index.db-wal
server/index.db-shm
.venv/

# test scaffolding — installed on demand, never committed
.uitest/
.screens/

# JM Agentic-OS Harness runtime state: DSH sessions, logs and its settings
# document. Machine state rather than memory, and the sessions contain whole
# conversations — which is exactly the kind of thing that should not be pushed to
# a public remote by a stray `git add -A`.
.dsh/

# Credentials. Nothing in this repo needs a key material file, so a broad ignore
# costs nothing and stops the common accident. `bash bin/os selftest` also scans
# tracked files for key and token signatures, because .gitignore does not help
# with a file that was added before it was ignored.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
*.env
!server/.env.example

# GCP service-account keys. These arrive as ordinary-looking .json, which the
# patterns above do not catch, and they are an identity rather than a scoped
# token — the worst single file to leak. Belt and braces: the shim's Vertex mode
# expects this file OUTSIDE the repo entirely (~/.dsh-harness/), and these
# patterns exist so that putting one here anyway is still not publishable.
*service-account*.json
*-sa.json
sa.json
vertex-sa.json
gcp-*.json
application_default_credentials.json

# Timestamped backups of credential files. `cp -a server/.env server/.env.bak.$(date)`
# is the natural thing to do before editing, and `*.env` does not match
# `.env.bak.20260830-164557`, so the copy was publishable while the original was
# not. Same for the harness env and any settings file holding a key.
*.env.bak*
*.bak.[0-9]*
settings.local.json*
